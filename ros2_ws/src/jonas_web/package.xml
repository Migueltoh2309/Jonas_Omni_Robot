<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jonas_web</name>
  <version>0.1.0</version>
  <description>Interfaz web de Jonas para el celular (modo manual: joystick, emociones, acciones de los brazos).</description>
  <maintainer email="molortegui@utec.edu.pe">MiTo Olortegui Huaman</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
